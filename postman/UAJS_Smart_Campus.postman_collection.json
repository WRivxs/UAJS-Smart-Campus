    {
      "name": "02. Búsqueda Global (Elasticsearch)",
      "description": "Motor de búsqueda full-text distribuido con análisis en español y fuzzy matching.",
      "item": [
        {
          "name": "2.1 Búsqueda Exacta ('carné')",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Elasticsearch retorna resultados coincidentes\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql(\"OK\");",
                  "    pm.expect(jsonData.total).to.be.at.least(1);",
                  "    pm.expect(jsonData.resultados).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/search?q=carné",
              "host": ["{{baseUrl}}"],
              "path": ["api", "search"],
              "query": [
                {
                  "key": "q",
                  "value": "carné"
                }
              ]
            }
          }
        },
        {
          "name": "2.2 Búsqueda con Tolerancia a Fallos - Fuzzy ('carne')",
          "event": [
            {
              "listen": "test",
