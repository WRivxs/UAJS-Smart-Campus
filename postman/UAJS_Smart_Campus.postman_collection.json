  "item": [
    {
      "name": "01. Autenticación & Usuarios",
      "description": "Endpoints de autenticación, emisión de JWT, consulta de perfil y gestión de roles.",
      "item": [
        {
          "name": "1.1 Login - Estudiante (Captura Automática de Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Retorna token JWT válido\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('token');",
                  "    pm.expect(jsonData.token).to.be.a('string');",
                  "    ",
                  "    // Almacenar token automáticamente en las variables para peticiones posteriores",
                  "    pm.collectionVariables.set(\"jwtToken\", jsonData.token);",
                  "    if (pm.environment) {",
                  "        pm.environment.set(\"jwtToken\", jsonData.token);",
                  "    }",
                  "});",
                  "",
                  "pm.test(\"Usuario autenticado con rol Estudiante\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.usuario.email).to.eql(\"estudiante@uajs.edu.co\");",
                  "    pm.expect(jsonData.usuario.rol_nombre).to.eql(\"Estudiante\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"estudiante@uajs.edu.co\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
